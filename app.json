{
  "name": "LashxBot",
  "description": "Ultimate WhatsApp Bot with Auto Features",
  "repository": "https://github.com/YOUR_GITHUB_USERNAME/YOUR_REPOSITORY_NAME",
  "logo": "https://i.ibb.co/6RqqZ5hg/file-000000005b908207bb180ce30137e11d.png",
  "keywords": [
    "whatsapp",
    "bot",
    "baileys",
    "lashxbot"
  ],
  "env": {
    "BOT_NAME": {
      "description": "Name of your bot",
      "value": "LashxBot",
      "required": false
    },
    "OWNER_NAME": {
      "description": "Owner's name",
      "value": "Lashan (Lashx)",
      "required": false
    },
    "OWNER_NUMBER": {
      "description": "Owner's WhatsApp number (with country code)",
      "value": "94781121579",
      "required": true
    },
    "PAIRING_NUMBER": {
      "description": "Number to request pairing code",
      "value": "94781121579",
      "required": false
    },
    "SESSION_ID": {
      "description": "Your WhatsApp Session ID (creds.json string)",
      "value": "",
      "required": false
    },
    "PREFIX": {
      "description": "Command prefix symbol (default: .)",
      "value": ".",
      "required": false
    },
    "WORK_MODE": {
      "description": "Bot work mode: private or public",
      "value": "public",
      "required": false
    },
    "AUTO_READ": {
      "description": "Auto read incoming messages (true/false)",
      "value": "false",
      "required": false
    },
    "AUTO_STATUS_VIEW": {
      "description": "Auto view WhatsApp statuses (true/false)",
      "value": "true",
      "required": false
    },
    "STATUS_EMOJI": {
      "description": "Emoji to react on status",
      "value": "🔥",
      "required": false
    },
    "ANTI_DELETE_TOGGLE": {
      "description": "Enable anti-delete feature (true/false)",
      "value": "true",
      "required": false
    },
    "ANTI_DELETE": {
      "description": "Anti delete target mode (group&inbox)",
      "value": "group&inbox",
      "required": false
    },
    "DELETE_MSG_SEND_TO": {
      "description": "JID or number to send deleted messages",
      "value": "",
      "required": false
    },
    "MAX_SIZE": {
      "description": "Max file download size in MB",
      "value": "100",
      "required": false
    },
    "AUTO_VIEW_ONCE": {
      "description": "Auto-forward View Once photo/video as normal media to your private chat (true/false)",
      "value": "true",
      "required": false
    },
    "VIEWONCE_SEND_TO": {
      "description": "Number to send recovered View Once media to (empty = bot's own chat)",
      "value": "",
      "required": false
    },
    "ALWAYS_ONLINE": {
      "description": "Keep bot always online (true/false)",
      "value": "true",
      "required": false
    },
    "AUTO_TYPING": {
      "description": "Show auto typing status (true/false)",
      "value": "false",
      "required": false
    },
    "AUTO_RECORDING": {
      "description": "Show auto recording status (true/false)",
      "value": "false",
      "required": false
    }
  },
  "buildpacks": [
    {
      "url": "heroku/nodejs"
    }
  ]
}
